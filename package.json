{
  "name": "chatgpt-advanced-latex-renderer",
  "version": "0.1.0",
  "description": "MV3 extension: MathJax 4 enhanced LaTeX rendering (mhchem, physics) for ChatGPT",
  "scripts": {
    "gen:fonts": "node scripts/gen-font-loaders.mjs",
    "build": "vite build && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "probe": "node scripts/probe-chatgpt.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "4.1.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "katex": "^0.19.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true
}
