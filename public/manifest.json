{
  "manifest_version": 3,
  "name": "ChatGPT Advanced LaTeX Renderer",
  "short_name": "Advanced LaTeX",
  "version": "0.2.0",
  "description": "Local MathJax 4 rendering for ChatGPT: mhchem (\\ce, \\pu), physics, AMS environments and custom macros. No data leaves the browser.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-loader.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*", "chunks/*"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ],
  "action": {
    "default_title": "Advanced LaTeX Renderer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
